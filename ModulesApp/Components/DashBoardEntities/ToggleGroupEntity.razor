@using ModulesApp.Models.Dasboards
@using System.Text.Json
@using ModulesApp.Models.Dasboards.Entities
@using ModulesApp.Services

@if (EditMode)
{
    <MudPaper Class="pa-3" Style="width:300px; min-height:20px">
        <MudStack Row="true">
            <MudTextField @bind-Value="@Entity.Name" Label="Id" Required=true />
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           OnClick="OnDeleteButtonClick" />
        </MudStack>
        <MudDivider Class="my-3" />

        @foreach (var item in Entity.Items)
        {
             <MudStack Row="true">
                <MudTextField @bind-Value="@item.Label" MaxLength="20" Label="Label" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="() => Entity.Items.Remove(item)" />
             </MudStack>
            
            <MudNumericField @bind-Value="@item.Value" Label="Value" />
            <MudSelect @bind-Value="item.Color" Label="Color">
                @foreach (var color in _colors)
                {
                    <MudSelectItem Value="@color.MudColor">
                        <MudPaper Style="@($"width:100%; height:15px; background-color:var({color.Css});")" />
                    </MudSelectItem>
                }
            </MudSelect>
           
            <MudDivider Class="my-2"/>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="() => Entity.AddNewItem()">
            Add
        </MudButton>
    </MudPaper>
}
else
{
    <MudToggleGroup T="int" SelectionMode="SelectionMode.SingleSelection" Value="Entity.Value" 
                    Disabled="_disabled" ValueChanged="OnValueChanged"
                    Style="width: 300px;" Color="Entity.Color" 
                    CheckMark=false FixedContent=false Size="Size.Large">
        @foreach (var item in Entity.Items)
        {
            <MudToggleItem Value="@item.Value" Text="@item.Label" Disabled="_disabled"/>
        }
    </MudToggleGroup>
}

@code
{
    [Parameter, EditorRequired]
    public DbToggleGroupEntity Entity { get; set; } = default!;
    [Parameter]
    public bool EditMode { get; set; } = false;
    [Parameter]
    public Action<DbDashboardEntity?>? DeleteButtonClick { get; set; }
    [Parameter]
    public ContextService? ServerContextService { get; set; }

    private bool _disabled = false;

    public static List<(Color MudColor, string Css)> _colors =
    [
        (Color.Primary, "--mud-palette-primary"),
        (Color.Info, "--mud-palette-info"),
        (Color.Success, "--mud-palette-success"),
        (Color.Warning, "--mud-palette-warning"),
        (Color.Error, "--mud-palette-error"),
        (Color.Dark, "--mud-palette-dark"),
    ];

    private void OnDeleteButtonClick()
    {
        DeleteButtonClick?.Invoke(Entity);
    }

    private async Task OnValueChanged(int value)
    {
        if(ServerContextService != null)
        {
            _disabled = true;
            Entity.Value = value;
            await ServerContextService.DashboardEntityUserTriggerAsync(Entity, "Value", Entity.Value);
            // await Task.Delay(500);
            _disabled = false;
        }
    }
}
