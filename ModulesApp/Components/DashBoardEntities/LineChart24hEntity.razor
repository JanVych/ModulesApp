@using ModulesApp.Models.Dasboards
@using ModulesApp.Models.Dasboards.Entities
@using ApexCharts

@* @implements IBrowserViewportObserver *@
@implements IAsyncDisposable

@* @inject IBrowserViewportService BrowserViewportService
 *@
@if (EditMode)
{
    <MudPaper Class="pa-3" Style="width:600px;">
        <MudStack StretchItems="StretchItems.All" AlignItems="AlignItems.Stretch" Spacing="1">
            <MudStack Row="true">
                <MudTextField @bind-Value="@Entity.Name" Label="Id" Required=true />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                Color="MudBlazor.Color.Error"
                OnClick="OnDeleteButtonClick" />
            </MudStack>
            <MudDivider />
            <MudSelect @bind-Value="@Entity.SampleFrequency" Label="Sample Frequency">
                @foreach (DbLineChart24hEntity.DataFrequencyType type in Enum.GetValues(typeof(DbLineChart24hEntity.DataFrequencyType)))
                {
                    <MudSelectItem Value="@type"/>
                }
            </MudSelect>

            <MudTextField @bind-Value="@Entity.Title" MaxLength="20" Label="Title" />
            <MudNumericField @bind-Value="Entity.RoundValuesTo" MaxLength="20" Label="Round values to" />
            @foreach (var serie in Entity.SeriesList)
            {
                <MudStack Row=true>
                    <MudTextField @bind-Value="serie.Name" Label="@GetSeriesName(serie)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                    Color="MudBlazor.Color.Error"
                    OnClick="@(() => DeleteSeries(serie))" />
                </MudStack>
                <MudSelect @bind-Value="@serie.Color" Label="Color">
                    @foreach (var color in _colors)
                    {
                        <MudSelectItem Value="@color">
                            <MudPaper Style="@SelectColorStyle(color)" />
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.body2">Add point message key: @GetSeriesValueMessage(serie)</MudText>

                <MudDivider Class="pt-2"/>
            }
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="AddSeries">
                Add Series
            </MudButton>


        </MudStack>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-3 chart-container" Style="width: 100%; height: 316px;">
        @if (_showChart)
        {
            <ApexChart @ref="_chart"
                       TItem="DbLineChart24hEntity.SeriesData"
                       Height="292"
                       Title="@Entity.Title"
                       Options="_chartOptions">
                @foreach (var serie in Entity.SeriesList)
                {
                    <ApexPointSeries TItem="DbLineChart24hEntity.SeriesData"
                                     Items="@serie.ReducedData"
                                     Name="@serie.Name"
                                     SeriesType="SeriesType.Line"
                                     Color="@serie.Color"
                                     XValue="e => e.Time"
                                     YValue="e => e.Value" />
                }
            </ApexChart>
        }
    </MudPaper>
    <style>
        .chart-container .apexcharts-canvas {
        width: 100% !important;
        } 
    </style>
}

