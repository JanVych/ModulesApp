                    Size = 0
                },

                Legend = new Legend
                {
                    Show = true,
                    Position = LegendPosition.Bottom,
                    HorizontalAlign = ApexCharts.Align.Center,
                    Floating = false,
                    Markers = new LegendMarkers
                    {
                        StrokeWidth = 0,
                    }

                },
                Xaxis = new XAxis
                {
                    Type = XAxisType.Datetime,
                    Tooltip = new XAxisTooltip { Enabled = false },
                    Labels = new XAxisLabels
                    {
                        Formatter = @"
                    function(value, timestamp, opts) {
                        if (!value) return '';

                        var d = new Date(value);
                        if (isNaN(d)) return '';

                        var globals = opts?.w?.globals;
                        var diff = globals ? globals.maxX - globals.minX : 0;

                        if (diff <= 4 * 60 * 60 * 1000) {
                            return d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
                        } else {
                            return d.getHours().toString().padStart(2, '0') + ':00';
                        }
                    }"
                    }
                },

                Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (val) {{ return val.toFixed({Entity.RoundValuesTo}); }}"
                    }
                }
            },

                Tooltip = new ApexCharts.Tooltip
                {
                    Enabled = true,
                    X = new TooltipX
                    {
                    // Format the x-value in the hover box to show exact time
                        Formatter = @"
                    function(value) {
                        var d = new Date(value);
                        return d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    }"
                    }
                }
            };

        Entity.UpdateAsync += UpdateSeries;
    }

    // TODO
    // After the first render, we need to call RenderAsync to ensure the chart is rerendered with the correct dimensions.
    // Task.Delay is used to ensure that the chart has been rendered at least once before we call RenderAsync, otherwise we might get an error about the chart not being initialized.
    // Task.Delay shud be removed in futere.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);

            if (_chart is not null)
            {
                await Task.Delay(200);
                try
                {
                    await _chart.RenderAsync();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"C# Exception rendering chart: {ex.Message}");
                }
            }
        }
    }

